# ============================================
# 小汪記記 V2 環境變數範例檔案
# ============================================
#
# 使用說明：
# 1. 複製此檔案為 .env (開發環境) 或 .env.production (生產環境)
# 2. 填入對應環境的實際值
# 3. 絕對不要將 .env 檔案上傳到 Git
#
# ============================================

# ============================================
# LINE Bot 設定
# ============================================
LINE_CHANNEL_ACCESS_TOKEN=你的_LINE_CHANNEL_ACCESS_TOKEN
LINE_CHANNEL_SECRET=你的_LINE_CHANNEL_SECRET

# ============================================
# Supabase 資料庫設定
# ============================================
SUPABASE_URL=https://你的專案ID.supabase.co
SUPABASE_ANON_KEY=你的_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=你的_SERVICE_ROLE_KEY

# 資料表前綴（開發環境用 dev_，生產環境可留空或用 prod_）
TABLE_PREFIX=dev_

# ============================================
# 服務器設定
# ============================================
# 基礎 URL（開發環境用 ngrok，生產環境用正式網域）
BASE_URL=https://your-domain.com

# Webhook URL（通常與 BASE_URL 相同）
WEBHOOK_BASE_URL=https://your-domain.com

# 環境類型（development 或 production）
NODE_ENV=development

# 伺服器埠號
PORT=3003

# ============================================
# Session 設定
# ============================================
SESSION_SECRET=your-secret-key-change-this-in-production

# ============================================
# LIFF APP 設定
# ============================================
LIFF_APP_ID=你的_LIFF_APP_ID
LIFF_COLLECTIONS_ID=你的_LIFF_COLLECTIONS_ID
LIFF_RECORDS_ID=你的_LIFF_RECORDS_ID
LIFF_ACCOUNT_ID=你的_LIFF_ACCOUNT_ID
LIFF_ANALYTICS_ID=你的_LIFF_ANALYTICS_ID

# ============================================
# OpenAI API 設定
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key

# ============================================
# Google Calendar API 設定
# ============================================
GOOGLE_CLIENT_ID=你的_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=你的_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=https://your-domain.com/api/google-calendar/callback

# ============================================
# Oen Payment 設定（測試環境）
# ============================================
OEN_PAYMENT_TEST_MERCHANT_ID=你的_MERCHANT_ID
OEN_PAYMENT_TEST_AUTH_TOKEN=你的_AUTH_TOKEN

# ============================================
# Oen Payment 設定（生產環境）
# ============================================
OEN_PAYMENT_MERCHANT_ID=你的_MERCHANT_ID
OEN_PAYMENT_AUTH_TOKEN=你的_AUTH_TOKEN
